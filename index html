<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verifikasi Data Tes Kompetensi Akademik (TKA) SN 10 Tahun 2026</title>
  
  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .glass-card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
    .bg-gradient-glow {
      background: radial-gradient(circle at 50% -20%, #4f46e5 0%, #06b6d4 45%, #0f172a 100%);
    }
    .transition-all-custom { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen bg-gradient-glow relative overflow-x-hidden">

  <!-- Glow Background -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 py-8 relative z-10 min-h-screen flex flex-col justify-center">

    <!-- HEADER -->
    <header class="text-center mb-8">
      <div class="inline-flex items-center gap-2 bg-indigo-500/20 border border-indigo-400/30 text-indigo-200 text-xs px-3 py-1.5 rounded-full font-semibold uppercase tracking-wider mb-3">
        <i data-lucide="shield-check" class="w-4 h-4 text-indigo-400"></i> Portal Resmi Konfirmasi Kurikulum SMANTARNALA
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
        Verifikasi Data Tes Kompetensi Akademik (TKA) <br class="hidden sm:inline">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-indigo-300">SN 10 Tahun 2026</span>
      </h1>
    </header>

    <!-- STATE 1: LOGIN -->
    <div id="loginSection" class="glass-card text-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl max-w-md mx-auto w-full border border-white/20">
      <div class="text-center mb-6">
        <div class="w-14 h-14 mx-auto items-center justify-center">
          <img src="https://lh3.googleusercontent.com/d/1erlU3Wwr8NuIusv6FXvG3qahEv7D1eQL">
        </div>


        <h2 class="text-xl font-bold text-slate-900">Masuk ke Sistem</h2>
        <p class="text-xs text-slate-500 mt-1">Masukkan NISN dan Tanggal Lahir untuk validasi data.</p>
      </div>

      <form id="loginForm" onsubmit="handleLoginSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">NISN (Nomor Induk Siswa Nasional)</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><i data-lucide="id-card" class="w-4 h-4"></i></span>
            <input type="text" id="inputNisn" required placeholder="Masukkan 10 digit NISN" 
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Lahir</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><i data-lucide="calendar" class="w-4 h-4"></i></span>
            <input type="date" id="inputTglLahir" required 
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div id="loginError" class="hidden p-3 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-600 flex items-center gap-2">
          <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
          <span id="loginErrorText">NISN atau Tanggal Lahir tidak cocok!</span>
        </div>

        <button type="submit" id="btnLogin" 
          class="w-full py-3 bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-700 hover:to-cyan-700 text-white font-semibold rounded-xl text-sm shadow-lg shadow-indigo-500/25 transition-all flex items-center justify-center gap-2">
          <span>Masuk / Autentikasi Data</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>
      </form>
    </div>

    <!-- STATE 2: UTAMA -->
    <div id="mainSection" class="hidden glass-card text-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl border border-white/20 transition-all-custom">
      <div class="bg-gradient-to-r from-indigo-900 to-slate-900 text-white rounded-2xl p-5 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-md">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-indigo-500/20 rounded-full border border-indigo-400/30 flex items-center justify-center text-indigo-300 font-bold text-lg">
            <i data-lucide="user" class="w-6 h-6"></i>
          </div>
          <div>
            <h3 id="displayNama" class="font-bold text-lg text-white">-</h3>
            <p id="displayKelas" class="text-xs text-indigo-300 font-medium">-</p>
          </div>
        </div>
        <button onclick="resetToLogin()" class="self-end sm:self-auto text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3 py-1.5 rounded-lg transition border border-slate-700 flex items-center gap-1.5">
          <i data-lucide="log-out" class="w-3.5 h-3.5"></i> Keluar
        </button>
      </div>

      <div class="mb-4">
        <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="file-check-2" class="w-5 h-5 text-indigo-600"></i> Periksa Data Anda (Poin 1–7)
        </h3>
        <p class="text-xs text-slate-500">Pastikan seluruh data di bawah ini sudah akurat sesuai dengan identitas Anda.</p>
      </div>

      <!-- GRID 7 POIN DATA -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        <div class="bg-white/80 border border-slate-200/80 rounded-2xl p-3.5 shadow-sm">
          <div class="text-[10px] font-bold text-indigo-600 uppercase mb-0.5">1. Nama Siswa</div>
          <div id="cardNama" class="text-sm font-semibold text-slate-800">-</div>
        </div>
        <div class="bg-white/80 border border-slate-200/80 rounded-2xl p-3.5 shadow-sm">
          <div class="text-[10px] font-bold text-indigo-600 uppercase mb-0.5">2. Kelas</div>
          <div id="cardKelas" class="text-sm font-semibold text-slate-800">-</div>
        </div>
        <div class="bg-white/80 border border-slate-200/80 rounded-2xl p-3.5 shadow-sm">
          <div class="text-[10px] font-bold text-indigo-600 uppercase mb-0.5">3. NIS</div>
          <div id="cardNIS" class="text-sm font-semibold text-slate-800">-</div>
        </div>
        <div class="bg-white/80 border border-slate-200/80 rounded-2xl p-3.5 shadow-sm">
          <div class="text-[10px] font-bold text-indigo-600 uppercase mb-0.5">4. NISN</div>
          <div id="cardNISN" class="text-sm font-semibold text-slate-800">-</div>
        </div>
        <div class="bg-white/80 border border-slate-200/80 rounded-2xl p-3.5 shadow-sm sm:col-span-2">
          <div class="text-[10px] font-bold text-indigo-600 uppercase mb-0.5">5. Tempat dan Tanggal Lahir</div>
          <div id="cardTTL" class="text-sm font-semibold text-slate-800">-</div>
        </div>
        <div class="bg-gradient-to-br from-indigo-50 to-white border border-indigo-100 rounded-2xl p-3.5 shadow-sm">
          <div class="text-[10px] font-bold text-indigo-600 uppercase mb-0.5">6. Mapel Pilihan TKA 1</div>
          <div id="cardTKA1" class="text-sm font-bold text-indigo-900">-</div>
        </div>
        <div class="bg-gradient-to-br from-cyan-50 to-white border border-cyan-100 rounded-2xl p-3.5 shadow-sm">
          <div class="text-[10px] font-bold text-cyan-600 uppercase mb-0.5">7. Mapel Pilihan TKA 2</div>
          <div id="cardTKA2" class="text-sm font-bold text-cyan-900">-</div>
        </div>
      </div>

      <!-- OPSI KONFIRMASI -->
      <form id="confirmForm" onsubmit="handleConfirmSubmit(event)" class="space-y-4 border-t border-slate-200 pt-6">
        <label class="block text-xs font-bold text-slate-900 uppercase">
          Pernyataan Konfirmasi Kebenaran Data <span class="text-rose-500">*</span>
        </label>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label id="labelOption1" onclick="selectOption('Sudah benar dan sesuai')" 
            class="flex items-start gap-3 p-4 rounded-2xl border-2 border-slate-200 bg-white/60 cursor-pointer hover:border-emerald-500 transition-all">
            <input type="radio" name="optionKonfirmasi" value="Sudah benar dan sesuai" class="mt-1 text-emerald-600">
            <div>
              <div class="text-sm font-bold text-slate-800">1. Sudah benar dan sesuai</div>
              <p class="text-xs text-slate-500 mt-0.5">Semua data 1–7 sudah pas & tidak ada perubahan.</p>
            </div>
          </label>

          <label id="labelOption2" onclick="selectOption('Ada kesalahan')" 
            class="flex items-start gap-3 p-4 rounded-2xl border-2 border-slate-200 bg-white/60 cursor-pointer hover:border-amber-500 transition-all">
            <input type="radio" name="optionKonfirmasi" value="Ada kesalahan" class="mt-1 text-amber-600">
            <div>
              <div class="text-sm font-bold text-slate-800">2. Ada kesalahan</div>
              <p class="text-xs text-slate-500 mt-0.5">Terdapat data yang perlu diperbaiki/direvisi.</p>
            </div>
          </label>
        </div>

        <div id="correctionArea" class="hidden pt-2">
          <label class="block text-xs font-bold text-amber-800 mb-1.5 flex items-center gap-1.5">
            <i data-lucide="edit-3" class="w-4 h-4 text-amber-600"></i> Rincian Data Yang Perlu Diperbaiki:
          </label>
          <textarea id="inputCatatan" rows="3" placeholder="Tuliskan data mana yang salah beserta perbaikannya..."
            class="w-full p-3 bg-white border border-amber-300 rounded-xl text-sm text-slate-800 focus:ring-2 focus:ring-amber-500 shadow-inner"></textarea>
        </div>

        <div class="pt-4">
          <button type="submit" id="btnSubmit" disabled
            class="w-full py-3.5 bg-slate-300 text-slate-500 cursor-not-allowed font-bold rounded-xl text-sm flex items-center justify-center gap-2">
            <span>Kirim Konfirmasi Data</span>
            <i data-lucide="send" class="w-4 h-4"></i>
          </button>
        </div>
      </form>
    </div>

    <!-- MODAL SUKSES -->
    <div id="successModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md">
      <div class="glass-card text-slate-800 bg-white rounded-3xl max-w-sm w-full p-6 text-center shadow-2xl">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full mx-auto flex items-center justify-center mb-4">
          <i data-lucide="check-circle-2" class="w-10 h-10"></i>
        </div>
        <h3 class="text-xl font-bold text-slate-900">Konfirmasi Berhasil!</h3>
        <p class="text-xs text-slate-600 mt-2">Data Anda telah berhasil tersimpan ke sistem.</p>
        <button onclick="resetToLogin()" class="mt-6 w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-md">
          Selesai / Kembali
        </button>
      </div>
    </div>

  </div>

  <script>
    // PASTE URL DEPLOYMENT GOOGLE APPS SCRIPT ANDA DI SINI
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwyxtZ7W181L6q61nOu8X4CQT2qeH26jYZddkTf8zV6rhwme4E53Lz6167PIuTfARDTrA/exec";

    lucide.createIcons();
    let currentUserData = null;
    let selectedStatus = null;

    // LOGIN API CALL
    async function handleLoginSubmit(event) {
      event.preventDefault();
      const nisn = document.getElementById('inputNisn').value.trim();
      const tglLahir = document.getElementById('inputTglLahir').value.trim();
      const btnLogin = document.getElementById('btnLogin');
      const errorBox = document.getElementById('loginError');

      errorBox.classList.add('hidden');
      btnLogin.disabled = true;
      btnLogin.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>Memeriksa...</span>`;
      lucide.createIcons();

      try {
        const response = await fetch(SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify({ action: "login", nisn: nisn, tglLahir: tglLahir })
        });
        const res = await response.json();

        btnLogin.disabled = false;
        btnLogin.innerHTML = `<span>Masuk / Autentikasi Data</span><i data-lucide="arrow-right" class="w-4 h-4"></i>`;
        lucide.createIcons();

        if (res.success) {
          currentUserData = res.data;
          showMainDashboard(res.data);
        } else {
          document.getElementById('loginErrorText').innerText = res.message;
          errorBox.classList.remove('hidden');
        }
      } catch (err) {
        btnLogin.disabled = false;
        btnLogin.innerHTML = `<span>Masuk / Autentikasi Data</span><i data-lucide="arrow-right" class="w-4 h-4"></i>`;
        lucide.createIcons();
        document.getElementById('loginErrorText').innerText = 'Gagal terhubung ke server Apps Script!';
        errorBox.classList.remove('hidden');
      }
    }

    function showMainDashboard(data) {
      document.getElementById('loginSection').classList.add('hidden');
      document.getElementById('mainSection').classList.remove('hidden');
      document.getElementById('displayNama').innerText = data.nama;
      document.getElementById('displayKelas').innerText = data.kelas;
      document.getElementById('cardNama').innerText = data.nama;
      document.getElementById('cardKelas').innerText = data.kelas;
      document.getElementById('cardNIS').innerText = data.nis;
      document.getElementById('cardNISN').innerText = data.nisn;
      document.getElementById('cardTTL').innerText = data.ttl;
      document.getElementById('cardTKA1').innerText = data.tka1;
      document.getElementById('cardTKA2').innerText = data.tka2;
    }

    function selectOption(status) {
      selectedStatus = status;
      const btnSubmit = document.getElementById('btnSubmit');
      const correctionArea = document.getElementById('correctionArea');
      const label1 = document.getElementById('labelOption1');
      const label2 = document.getElementById('labelOption2');

      btnSubmit.disabled = false;
      btnSubmit.className = "w-full py-3.5 bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-700 hover:to-cyan-700 text-white font-bold rounded-xl text-sm shadow-lg cursor-pointer flex items-center justify-center gap-2";

      if (status === 'Sudah benar dan sesuai') {
        correctionArea.classList.add('hidden');
        document.getElementById('inputCatatan').removeAttribute('required');
        label1.className = "flex items-start gap-3 p-4 rounded-2xl border-2 border-emerald-500 bg-emerald-50/50 cursor-pointer shadow-sm transition-all";
        label2.className = "flex items-start gap-3 p-4 rounded-2xl border-2 border-slate-200 bg-white/60 cursor-pointer transition-all";
      } else {
        correctionArea.classList.remove('hidden');
        document.getElementById('inputCatatan').setAttribute('required', 'true');
        label1.className = "flex items-start gap-3 p-4 rounded-2xl border-2 border-slate-200 bg-white/60 cursor-pointer transition-all";
        label2.className = "flex items-start gap-3 p-4 rounded-2xl border-2 border-amber-500 bg-amber-50/50 cursor-pointer shadow-sm transition-all";
      }
    }

    // SUBMIT CONFIRMATION API CALL
    async function handleConfirmSubmit(event) {
      event.preventDefault();
      if (!selectedStatus || !currentUserData) return;

      const btnSubmit = document.getElementById('btnSubmit');
      const catatanText = document.getElementById('inputCatatan').value.trim();

      btnSubmit.disabled = true;
      btnSubmit.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>Menyimpan...</span>`;
      lucide.createIcons();

      const payload = {
        nisn: currentUserData.nisn,
        nama: currentUserData.nama,
        kelas: currentUserData.kelas,
        status: selectedStatus,
        catatan: catatanText
      };

      try {
        const response = await fetch(SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify({ action: "submit", payload: payload })
        });
        const res = await response.json();

        if (res.success) {
          document.getElementById('successModal').classList.remove('hidden');
          confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
        } else {
          alert('Gagal menyimpan: ' + res.message);
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = `<span>Kirim Konfirmasi Data</span><i data-lucide="send" class="w-4 h-4"></i>`;
          lucide.createIcons();
        }
      } catch (err) {
        alert('Terjadi kesalahan jaringan!');
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = `<span>Kirim Konfirmasi Data</span><i data-lucide="send" class="w-4 h-4"></i>`;
        lucide.createIcons();
      }
    }

    // RESET FUNCTION UNTUK KEMBALI KE HALAMAN LOGIN
    function resetToLogin() {
      document.getElementById('successModal').classList.add('hidden');
      document.getElementById('mainSection').classList.add('hidden');
      document.getElementById('loginSection').classList.remove('hidden');
      document.getElementById('loginForm').reset();
      document.getElementById('loginError').classList.add('hidden');
      document.getElementById('confirmForm').reset();
      document.getElementById('correctionArea').classList.add('hidden');
      document.getElementById('inputCatatan').removeAttribute('required');

      const btnSubmit = document.getElementById('btnSubmit');
      btnSubmit.disabled = true;
      btnSubmit.className = "w-full py-3.5 bg-slate-300 text-slate-500 cursor-not-allowed font-bold rounded-xl text-sm flex items-center justify-center gap-2";
      btnSubmit.innerHTML = `<span>Kirim Konfirmasi Data</span><i data-lucide="send" class="w-4 h-4"></i>`;

      document.getElementById('labelOption1').className = "flex items-start gap-3 p-4 rounded-2xl border-2 border-slate-200 bg-white/60 cursor-pointer transition-all";
      document.getElementById('labelOption2').className = "flex items-start gap-3 p-4 rounded-2xl border-2 border-slate-200 bg-white/60 cursor-pointer transition-all";

      currentUserData = null;
      selectedStatus = null;
      lucide.createIcons();
    }
  </script>
</body>
</html>
